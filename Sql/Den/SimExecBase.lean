  insertView := by intros; unfold Sql.insertView; exact Sim.outOfFuel _
  updateView := by intros; unfold Sql.updateView; exact Sim.outOfFuel _
  deleteView := by intros; unfold Sql.deleteView; exact Sim.outOfFuel _
  runViewTriggers := by intros; unfold Sql.runViewTriggers; exact Sim.outOfFuel _
  runTriggers := by intros; unfold Sql.runTriggers; exact Sim.outOfFuel _


  updateView : ∀ (q : QEnv) (vname : Name) (sets : List (List Name × Expr)) (wh : Option Expr), Sim ch (Sql.updateView fuel q vname sets wh) (Den.updateView q vname sets wh)
  deleteView : ∀ (q : QEnv) (vname : Name) (wh : Option Expr), Sim ch (Sql.deleteView fuel q vname wh) (Den.deleteView q vname wh)

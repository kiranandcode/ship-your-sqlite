/-
  The interpreter's Resolve block is simulated by the denotation at every fuel
  (Phase 2.6g), and the helpers after it. Generated by scripts/dev/gen_simblock.py.
-/
import Sql.Den.SimResolveAuto

namespace Sql.Den

open Sql

/-- The Resolve block is simulated at every fuel. -/
theorem resolveSim (ch : Choices) : ∀ fuel, ResolveSim ch fuel
  | 0 => resolveSim_zero ch
  | fuel + 1 =>
    have ih := resolveSim ch fuel
    {
      staticExpr := sim_staticExpr ih,
      staticFrom := sim_staticFrom ih,
      staticSelectMeta := sim_staticSelectMeta ih,
      staticCore := sim_staticCore ih,
      staticSelect := sim_staticSelect ih }

theorem Sim.staticExpr {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (e : Expr), Sim ch (Sql.staticExpr fuel q e) (Den.staticExpr q e) :=
  (resolveSim ch fuel).staticExpr

theorem Sim.staticFrom {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (f0 : FromItem), Sim ch (Sql.staticFrom fuel q f0) (Den.staticFrom q f0) :=
  (resolveSim ch fuel).staticFrom

theorem Sim.staticSelectMeta {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (sel : Select), Sim ch (Sql.staticSelectMeta fuel q sel) (Den.staticSelectMeta q sel) :=
  (resolveSim ch fuel).staticSelectMeta

theorem Sim.staticCore {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (core : SelectCore) (orderBy : List OrderTerm), Sim ch (Sql.staticCore fuel q core orderBy) (Den.staticCore q core orderBy) :=
  (resolveSim ch fuel).staticCore

theorem Sim.staticSelect {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (sel : Select), Sim ch (Sql.staticSelect fuel q sel) (Den.staticSelect q sel) :=
  (resolveSim ch fuel).staticSelect

theorem Sim.staticStmt {ch : Choices} :
    ∀ (fuel : Nat) (s : Stmt), Sim ch (Sql.staticStmt fuel s) (Den.staticStmt s) := by
  intros; unfold Sql.staticStmt Den.staticStmt; sim

end Sql.Den

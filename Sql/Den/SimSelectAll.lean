/-
  Every function of the interpreter's query block is simulated by its
  denotation, at every fuel (Phase 2.6g): induction on the fuel, from
  `selectSim_zero` and the lemmas at fuel + 1. Generated by
  scripts/dev/gen_simselect.py.
-/
import Sql.Den.SimSelectAuto
import Sql.Den.SimSelectWindow
import Sql.Den.SimSelectManual

namespace Sql.Den

open Sql

/-- The query block is simulated at every fuel. -/
theorem selectSim (ch : Choices) : ∀ fuel, SelectSim ch fuel
  | 0 => selectSim_zero ch
  | fuel + 1 =>
    have ih := selectSim ch fuel
    {
      evalExpr := sim_evalExpr ih,
      compareRows := sim_compareRows ih,
      valueOf := sim_valueOf ih,
      evalAgg := sim_evalAgg ih,
      aggFinish := sim_aggFinish ih,
      callAgg := sim_callAgg ih,
      argIsJson := sim_argIsJson ih,
      callFn := sim_callFn ih,
      callFnST := sim_callFnST ih,
      condJump := sim_condJump ih,
      condHolds := sim_condHolds ih,
      evalExprST := sim_evalExprST ih,
      resolveWindow := sim_resolveWindow ih,
      computeWindow := sim_computeWindow ih,
      windowRowValue := sim_windowRowValue ih,
      windowPartition := sim_windowPartition ih,
      evalFromWhereS := sim_evalFromWhereS ih,
      evalFromWhere := sim_evalFromWhere ih,
      namedSource := sim_namedSource ih,
      cteRows := sim_cteRows ih,
      evalFrom := sim_evalFrom ih,
      viewCols := sim_viewCols ih,
      tableFnSrc := sim_tableFnSrc ih,
      tableFunction := sim_tableFunction ih,
      expandCols := sim_expandCols ih,
      runCore := sim_runCore ih,
      runStream := sim_runStream ih,
      runGrouped := sim_runGrouped ih,
      runRows := sim_runRows ih,
      windowOut := sim_windowOut ih,
      aggCtxs := sim_aggCtxs ih,
      groupCtx := sim_groupCtx ih,
      runSelect := sim_runSelect ih,
      limitOffset := sim_limitOffset ih,
      runSimple := sim_runSimple ih,
      runUnionAll := sim_runUnionAll ih,
      runCompound := sim_runCompound ih }

theorem Sim.evalExpr {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (e : Expr), Sim ch (Sql.evalExpr fuel q e) (Den.evalExpr q e) :=
  (selectSim ch fuel).evalExpr


/-
  The interpreter's Resolve block is simulated by the denotation (Phase 2.6g),
  part 1: the helpers before the block, and the statement for every fuel
  (`ResolveSim`). Generated by scripts/dev/gen_simblock.py.
-/
import Sql.Den.SimSelectAll

namespace Sql.Den

open Sql

theorem Sim.checkCall {ch : Choices} :
    ∀ (n : Name) (nargs : Nat), Sim ch (Sql.checkCall n nargs) (Den.checkCall n nargs) := by
  intros; unfold Sql.checkCall Den.checkCall; sim

/-- Every function of the interpreter's Resolve block, at `fuel`, is simulated by
    its denotation. -/
structure ResolveSim (ch : Choices) (fuel : Nat) : Prop where
  staticExpr : ∀ (q : QEnv) (e : Expr), Sim ch (Sql.staticExpr fuel q e) (Den.staticExpr q e)
  staticFrom : ∀ (q : QEnv) (f0 : FromItem), Sim ch (Sql.staticFrom fuel q f0) (Den.staticFrom q f0)
  staticSelectMeta : ∀ (q : QEnv) (sel : Select), Sim ch (Sql.staticSelectMeta fuel q sel) (Den.staticSelectMeta q sel)
  staticCore : ∀ (q : QEnv) (core : SelectCore) (orderBy : List OrderTerm), Sim ch (Sql.staticCore fuel q core orderBy) (Den.staticCore q core orderBy)
  staticSelect : ∀ (q : QEnv) (sel : Select), Sim ch (Sql.staticSelect fuel q sel) (Den.staticSelect q sel)

/-- At fuel 0 every function of the block runs out of fuel. -/
theorem resolveSim_zero (ch : Choices) : ResolveSim ch 0 where
  staticExpr := by intros; unfold Sql.staticExpr; exact Sim.outOfFuel _
  staticFrom := by intros; unfold Sql.staticFrom; exact Sim.outOfFuel _
  staticSelectMeta := by intros; unfold Sql.staticSelectMeta; exact Sim.outOfFuel _
  staticCore := by intros; unfold Sql.staticCore; exact Sim.outOfFuel _
  staticSelect := by intros; unfold Sql.staticSelect; exact Sim.outOfFuel _

set_option hygiene false in
/-- The fields of an induction hypothesis `ResolveSim ch fuel`, as hypotheses `h_f`. -/
macro "resolve_ih " ih:ident : tactic =>
  `(tactic| obtain ⟨h_staticExpr, h_staticFrom, h_staticSelectMeta, h_staticCore, h_staticSelect⟩ := $ih)

end Sql.Den

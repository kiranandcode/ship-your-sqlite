theorem sim_execStmt {ch : Choices} {fuel : Nat} (ih : ExecSim ch fuel) :
    ∀ (q : QEnv) (s : Stmt), Sim ch (Sql.execStmt (fuel + 1) q s) (Den.execStmt q s) := by
  intro q s
  cases s with
  | select x_q => exact sim_execStmt_select ih q x_q
  | createTable temp ifNotExists schema name cols constraints withoutRowid strict asSelect text tailAtStart => exact sim_execStmt_createTable ih q temp ifNotExists schema name cols constraints withoutRowid strict asSelect text tailAtStart
  | insert with_ orConflict schema table «alias» cols source upserts returning => exact sim_execStmt_insert ih q with_ orConflict schema table «alias» cols source upserts returning
  | update with_ orConflict schema table «alias» sets from_ where_ returning orderBy limit offset => exact sim_execStmt_update ih q with_ orConflict schema table «alias» sets from_ where_ returning orderBy limit offset
  | delete with_ schema table «alias» where_ returning orderBy limit offset => exact sim_execStmt_delete ih q with_ schema table «alias» where_ returning orderBy limit offset
  | createIndex unique ifNotExists schema name table cols where_ text => exact sim_execStmt_createIndex ih q unique ifNotExists schema name table cols where_ text
  | createView temp ifNotExists schema name cols x_q text => exact sim_execStmt_createView ih q temp ifNotExists schema name cols x_q text
  | createTrigger temp ifNotExists schema name time event table forEachRow when_ body text tailAtBegin => exact sim_execStmt_createTrigger ih q temp ifNotExists schema name time event table forEachRow when_ body text tailAtBegin
  | drop kind ifExists schema name => exact sim_execStmt_drop ih q kind ifExists schema name
  | begin_ mode => exact sim_execStmt_begin_ ih q mode
  | commit  => exact sim_execStmt_commit ih q 
  | rollback savepoint => exact sim_execStmt_rollback ih q savepoint
  | savepoint name => exact sim_execStmt_savepoint ih q name
  | release name => exact sim_execStmt_release ih q name
  | pragma schema name arg call => exact sim_execStmt_pragma ih q schema name arg call
  | alterRename schema table newName => exact sim_execStmt_alterRename ih q schema table newName
  | alterRenameColumn schema table old new => exact sim_execStmt_alterRenameColumn ih q schema table old new
  | alterAddColumn schema table col text => exact sim_execStmt_alterAddColumn ih q schema table col text
  | alterDropColumn schema table col => exact sim_execStmt_alterDropColumn ih q schema table col
  | attach file schema => exact sim_execStmt_attach ih q file schema
  | detach schema => exact sim_execStmt_detach ih q schema
  | vacuum schema into => exact sim_execStmt_vacuum ih q schema into
  | reindex name => exact sim_execStmt_reindex ih q name
  | analyze name => exact sim_execStmt_analyze ih q name
  | explain queryPlan x_s => exact sim_execStmt_explain ih q queryPlan x_s
  | createVirtualTable ifNotExists schema name module args tailAt => exact sim_execStmt_createVirtualTable ih q ifNotExists schema name module args tailAt


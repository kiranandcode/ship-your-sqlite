theorem Sim.scalarFn7 {ch : Choices} (n : Name) (vs : List Value) (colls : List (Option (Coll × Bool))) :
    Sim ch (Sql.scalarFn7 n vs colls) (Den.scalarFn7 n vs colls) := by
  unfold Sql.scalarFn7 Den.scalarFn7
  sim
  -- PRNG draws (random, randomblob): the drawn values are the denotation's
  all_goals first
    | ((try intro _); split <;> omega)
    | ((try intro _); simp [ByteArray.size])


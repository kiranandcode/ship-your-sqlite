/-
  The interpreter's Exec block is simulated by the denotation at every fuel
  (Phase 2.6g), and the helpers after it. Generated by scripts/dev/gen_simblock.py.
-/
import Sql.Den.SimExecAuto

namespace Sql.Den

open Sql

/-- The Exec block is simulated at every fuel. -/
theorem execSim (ch : Choices) : ∀ fuel, ExecSim ch fuel
  | 0 => execSim_zero ch
  | fuel + 1 =>
    have ih := execSim ch fuel
    {
      execStmt := sim_execStmt ih,
      fkOnParentDelete := sim_fkOnParentDelete ih,
      fkOnParentUpdate := sim_fkOnParentUpdate ih,
      viewWithTriggers := sim_viewWithTriggers ih,
      viewRows := sim_viewRows ih,
      insertView := sim_insertView ih,
      updateView := sim_updateView ih,
      deleteView := sim_deleteView ih,
      runViewTriggers := sim_runViewTriggers ih,
      runTriggers := sim_runTriggers ih }

theorem Sim.execStmt {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (s : Stmt), Sim ch (Sql.execStmt fuel q s) (Den.execStmt q s) :=
  (execSim ch fuel).execStmt

theorem Sim.fkOnParentDelete {ch : Choices} {fuel : Nat} :
    ∀ (pname : Name) (pr : Row), Sim ch (Sql.fkOnParentDelete fuel pname pr) (Den.fkOnParentDelete pname pr) :=
  (execSim ch fuel).fkOnParentDelete

theorem Sim.fkOnParentUpdate {ch : Choices} {fuel : Nat} :
    ∀ (pname : Name) (old : Row) (new : Row), Sim ch (Sql.fkOnParentUpdate fuel pname old new) (Den.fkOnParentUpdate pname old new) :=
  (execSim ch fuel).fkOnParentUpdate

theorem Sim.viewWithTriggers {ch : Choices} {fuel : Nat} :
    ∀ (n : Name), Sim ch (Sql.viewWithTriggers fuel n) (Den.viewWithTriggers n) :=
  (execSim ch fuel).viewWithTriggers

theorem Sim.viewRows {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (n : Name), Sim ch (Sql.viewRows fuel q n) (Den.viewRows q n) :=
  (execSim ch fuel).viewRows

theorem Sim.insertView {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (vname : Name) (cols : List Name) (src : InsertSource), Sim ch (Sql.insertView fuel q vname cols src) (Den.insertView q vname cols src) :=
  (execSim ch fuel).insertView

theorem Sim.updateView {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (vname : Name) (sets : List (List Name × Expr)) (wh : Option Expr), Sim ch (Sql.updateView fuel q vname sets wh) (Den.updateView q vname sets wh) :=
  (execSim ch fuel).updateView

theorem Sim.deleteView {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (vname : Name) (wh : Option Expr), Sim ch (Sql.deleteView fuel q vname wh) (Den.deleteView q vname wh) :=
  (execSim ch fuel).deleteView

theorem Sim.runViewTriggers {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (vname : Name) (ev : TriggerEvent) (old : Option Row) (new : Option Row) (src : Src), Sim ch (Sql.runViewTriggers fuel q vname ev old new src) (Den.runViewTriggers q vname ev old new src) :=
  (execSim ch fuel).runViewTriggers

theorem Sim.runTriggers {ch : Choices} {fuel : Nat} :
    ∀ (q : QEnv) (time : TriggerTime) (ev : TriggerEvent) (table : Name) (old : Option Row) (new : Option Row), Sim ch (Sql.runTriggers fuel q time ev table old new) (Den.runTriggers q time ev table old new) :=
  (execSim ch fuel).runTriggers

end Sql.Den
